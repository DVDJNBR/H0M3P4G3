# H0M3P4G3 configuration — copy this file to `.env` at the repo root for
# local dev (`cp .env.example .env`). `.env` is gitignored; secrets come
# from the environment only (AD-6) and must never be committed.

# Bcrypt hash of the owner password (bcryptjs, story 1.3). This is a hash
# of the dev password "dev-password" -- fine for local dev, never use it
# beyond that.
PASSWORD_HASH=$2b$10$TMDWoYOG8P7lJ5CjrP1eju3/Wy9iggiJt6OzxQu1o08xhGj.y0M9K

# Base32 TOTP secret, RFC 6238 (dev placeholder — story 1.3 uses it). Must
# decode to at least 16 bytes (otplib's minimum secret length).
TOTP_SECRET=2VUUIZYIXPJELMXFIZJZ4Y767RFCUB5H

# Secret used to HMAC-sign session cookies. Rotate to revoke all sessions.
SESSION_SECRET=dev-session-secret-change-me

# Raindrop.io API token (features land in Epic 3; required config already).
RAINDROP_TOKEN=dev-raindrop-token

# Optional — defaults shown.
PORT=3000
DATA_DIR=./data
